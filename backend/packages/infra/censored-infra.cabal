cabal-version: 3.8
name: censored-infra
version: 0.1.0.0
license: AGPL-3.0-or-later
copyright: 2026 asuka1975
build-type: Simple

-- ミューテーション計測用。通常のビルドでは無効(TQ-M8)。
flag mutation
  default: False
  manual: True

common defaults
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    OverloadedStrings

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Censored.Infra.Grapheme
  build-depends:
    , base
    , text
    , text-icu >=0.8

test-suite censored-infra-spec
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    Censored.Infra.GraphemeDomainSpec
    Censored.Infra.GraphemeSpec
  build-tool-depends: sydtest-discover:sydtest-discover
  build-depends:
    , base
    , censored-domain
    , censored-infra
    , hedgehog
    , sydtest
    , sydtest-hedgehog
    , text
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  if flag(mutation)
    build-depends: sydtest-mutation-runtime
