cabal-version: 3.8
name: censored-domain
version: 0.1.0.0
license: AGPL-3.0-or-later
copyright: 2026 asuka1975
build-type: Simple

-- ミューテーション計測用。通常のビルドでは無効(TQ-M8)。
flag mutation
  default: False
  manual: True

common defaults
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    OverloadedStrings

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Censored.Domain.Candidates
    Censored.Domain.Length
    Censored.Domain.PostBody
    Censored.Domain.Topic
    Censored.Domain.Whitespace
  build-depends:
    , base
    , text
  if flag(mutation)
    build-depends:
      , sydtest-mutation-plugin
      , sydtest-mutation-runtime
    ghc-options:
      -fplugin=Test.Syd.Mutation.Plugin
      -plugin-package=sydtest-mutation-plugin
      -package=sydtest-mutation-plugin

test-suite censored-domain-spec
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    Censored.Domain.CandidatesSpec
    Censored.Domain.LengthSpec
    Censored.Domain.PostBodySpec
    Censored.Domain.TestCounters
    Censored.Domain.TopicSpec
    Censored.Domain.WhitespaceSpec
  build-tool-depends: sydtest-discover:sydtest-discover
  build-depends:
    , base
    , censored-domain
    , hedgehog
    , sydtest
    , sydtest-hedgehog
    , text
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  if flag(mutation)
    build-depends: sydtest-mutation-runtime
